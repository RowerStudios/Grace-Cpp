#each nodes can have a script with the obj.script = parent.(location to the script)
n1 = new_node("node")
n1.properties = {
    n1.main = true
    n1.name = "main_node"
    n1.script = parent."Scripts".test
}

n2 = new_node("text_2d")
n2.properties = {
    n2.parent = n1
    n2.pos = (50,50) 
    n2.name = "text"
    n2.txt = "lol"
}

n3 = new_node("sound_2d")
n3.properties = {
    n3.name = "bruh"
    n3.parent = n1
    n3.sound = parent."Sounds".bruh
    n3.volume = 1.0
    n3.autoplay = true
    n3.looped = false
    n3.pitch = 1.0
    n3.speed = 1.0
}

n4 = new_node("button_2d")
n4.properties = {
    n3.name = "button"
    n3.parent = n1
    n3.active = true
    n3.use_qt = false
    n3.pos = (50,80)
    n3.visible = false
}
